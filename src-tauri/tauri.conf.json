{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "No Limit",
  "version": "1.0.0",
  "identifier": "de.nolimit.spiel",
  "build": {
    "beforeBuildCommand": "rm -rf dist && mkdir dist && cp -r index.html style.css logos.js game.js manifest.webmanifest icons dist/",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Game",
    "copyright": "No Limit",
    "shortDescription": "Idle-Clicker für die Zeit ohne Claude-Limit",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
